# Toolchain image for tooling/docker.sh (C-016).
#
# JDK 25 on Ubuntu Noble — the same major version GitHub Actions provisions and
# the level the build targets (`maven.compiler.release`, C-001/NFR-032). The tag
# is pinned to `-noble` because the Playwright package names below are
# distribution specific.
FROM eclipse-temurin:25-jdk-noble

# System libraries the Playwright Chromium build links against. Without them
# `./mvnw verify` downloads the browser successfully and then fails to launch it.
# This is the `playwright install --with-deps chromium` package list for Noble;
# it is baked in at build time because installing it at run time would need root,
# which conflicts with running the container as the host user (NFR-033).
RUN apt-get update \
      && apt-get install -y --no-install-recommends \
           ca-certificates \
           fonts-liberation \
           libasound2t64 \
           libatk-bridge2.0-0t64 \
           libatk1.0-0t64 \
           libatspi2.0-0t64 \
           libcairo2 \
           libcups2t64 \
           libdbus-1-3 \
           libdrm2 \
           libgbm1 \
           libglib2.0-0t64 \
           libnspr4 \
           libnss3 \
           libpango-1.0-0 \
           libx11-6 \
           libxcb1 \
           libxcomposite1 \
           libxdamage1 \
           libxext6 \
           libxfixes3 \
           libxkbcommon0 \
           libxrandr2 \
      && rm -rf /var/lib/apt/lists/* \
      && mkdir -p /home/dev && chmod 777 /home/dev

# No USER instruction on purpose: docker.sh passes `--user <host uid>:<host gid>`
# so build output stays owned by the invoking user (NFR-033), and that id is not
# known at build time. /home/dev is its home directory — it has no /etc/passwd
# entry here, so the directory cannot be owned by it and carries mode 777 instead.
# docker.sh mounts a named volume over that path, which inherits the mode, so
# ~/.m2 and ~/.cache/ms-playwright stay writable and survive between runs (NFR-034).
ENV HOME=/home/dev
